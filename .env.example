POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
DATABASE_URL=postgresql+asyncpg://forge:forge@postgres:5432/forge
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
RATE_LIMITER_BACKEND=memory
ACCOUNT_LOCKOUT_ENABLED=true
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_WINDOW_SECONDS=900
ACCOUNT_LOCKOUT_DURATION_SECONDS=900
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
MFA_CHALLENGE_EXPIRE_MINUTES=5
BACKUP_DIR=./backups
BACKUP_RETENTION=14
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
INVITE_EXPIRE_DAYS=7
PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_INTERNAL_URL=http://api:8000/api/v1
